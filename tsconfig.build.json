{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Ensure the compiler never treats existing dist artifacts as inputs
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "index.ts"
  ],
  "exclude": [
    // Avoid TS5055: do not include any generated output as inputs.
    // NOTE: do not blanket-exclude "**/*.d.ts" — that would drop the handwritten
    // ambient shim src/types/external.d.ts (declare module '@ts-evtx/messages'),
    // which lets core compile standalone without the optional messages package
    // being built. Generated declarations live under dist/ (already excluded).
    "dist",
    "dist/**/*",
    "packages/*/dist",
    // Project non-sources
    "test",
    "node_modules",
    "python-source"
  ]
}

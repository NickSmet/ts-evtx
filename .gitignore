# Node/TypeScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build artifacts
*.tsbuildinfo
**/dist/
coverage/
.cache/
tmp/
temp/

# Stray compiled output in the core source tree (the build emits to dist/ only).
# Hand-written declarations (e.g. src/types/external.d.ts) are re-included below.
/index.js
/index.d.ts
/index.js.map
/index.d.ts.map
/src/**/*.js
/src/**/*.js.map
/src/**/*.d.ts
/src/**/*.d.ts.map
!/src/types/external.d.ts

# macOS
.DS_Store

# Python (dev-only tooling)
venv/
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
python-evtx/

# Editor
.vscode/
.idea/

# Large binary samples (keep test fixtures only)
*.evtx
!test/fixtures/*.evtx

# SQLite byproducts and local DBs
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.db
!packages/**/assets/*.db

# Local merge inputs (packaged DB is kept under packages/*/assets)
dbs-for-merge/

# Environment
.env*
